      DECLARE @var sysname;&#xD;
      SELECT @var = [d].[name]&#xD;
      FROM [sys].[default_constraints] [d]&#xD;
      INNER JOIN [sys].[columns] [c] ON [d].[parent_column_id] = [c].[column_id] AND [d].[parent_object_id] = [c].[object_id]&#xD;
      WHERE ([d].[parent_object_id] = OBJECT_ID(N'[persona]') AND [c].[name] = N'LastName');&#xD;
